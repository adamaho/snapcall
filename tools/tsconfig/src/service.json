{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@adamaho/nopeus-tsconfig/effect", "@adamaho/nopeus-tsconfig/node"],
  "compilerOptions": {
    "resolvePackageJsonImports": true,
    "rewriteRelativeImportExtensions": false,
    "incremental": true,
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
